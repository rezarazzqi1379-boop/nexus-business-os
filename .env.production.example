NEXUS_AUTH_REQUIRED=1
NEXUS_ACCESS_TOKEN=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
NEXUS_STATE_DB=/data/state.db
NEXUS_CANONICAL_DB=/data/canonical.db
NEXUS_VAULT_ROOT=/data/nexus_vault
NEXUS_DATA_DIR=/data
NEXUS_CANONICAL_SOURCE_DIR=/app/canonical_source_files
OPENAI_API_KEY=
PORT=8421

# Optional observability. Keep disabled until a deployment target is explicitly approved.
NEXUS_POSTHOG_ENABLED=0
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=
