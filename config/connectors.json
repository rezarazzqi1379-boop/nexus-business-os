      "read_capable": true,
      "write_capable": true,
      "freshness_seconds": 3600,
      "credential_locator": "connector://vercel"
    },
    {
      "connector_id": "railway",
      "system": "Railway",
      "authority_scope": ["deployment_state", "runtime_health"],
      "project_scope": ["*"],
      "read_capable": true,
