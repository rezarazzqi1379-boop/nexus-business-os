+import pytest
+from datetime import datetime, timezone, timedelta
+
+
+@pytest.mark.parametrize("stamp", [None, "2000-01-01T00:00:00+00:00", "2999-01-01T00:00:00+00:00", "2026-11-01T00:00:00"])
+def test_unfresh_source_remains_visible_without_content_change(tmp_path, stamp):
+    for lane in gate.LANES:
+        folder = tmp_path / '.nexus/acquisition-lab' / lane
+        folder.mkdir(parents=True)
+        payload = dict(project_id='SANDBOX', records=[])
+        if stamp is not None: payload['observed_at'] = stamp
+        (folder / 'latest.json').write_text(json.dumps(payload))
+        (folder / 'last-attempt.json').write_text(json.dumps(dict(result='PASS')))
+    gate.run(tmp_path)
+    report = gate.run(tmp_path)
+    assert report['review_required'] is True
+    assert sorted(report['source_errors']) == sorted(gate.LANES)
+
+
+@pytest.mark.parametrize("lane,days,stale", [('market-context',7,False),('market-context',9,True),('ted-notices',1,False),('ted-notices',3,True),('opportunity-radar',3,True)])
+def test_cache_cadence_specific_age_bounds(tmp_path, lane, days, stale):
+    now = datetime.now(timezone.utc)
+    for name in gate.LANES:
+        folder = tmp_path / '.nexus/acquisition-lab' / name
+        folder.mkdir(parents=True)
+        stamp = now - timedelta(days=days if name == lane else 0)
+        (folder / 'latest.json').write_text(json.dumps(dict(project_id='SANDBOX',records=[],observed_at=stamp.isoformat())))
+        (folder / 'last-attempt.json').write_text(json.dumps(dict(result='PASS')))
+    gate.run(tmp_path)
+    report = gate.run(tmp_path)
+    assert (lane in report['source_errors']) is stale
+    assert report['review_required'] is stale
